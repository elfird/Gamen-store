# ─── Database (Supabase PostgreSQL) ──────────────────────────────────────────
# Connection pooler URL (Transaction mode, port 6543) - used by app at runtime
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct database connection URL (Session mode, port 5432) - used by Prisma Migrate
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ─── Application ──────────────────────────────────────────────────────────────
# Public base URL of the application (used for metadata and og: tags).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Authentication ───────────────────────────────────────────────────────────
# Secret key used to sign Auth.js sessions. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=""

# ─── WhatsApp ─────────────────────────────────────────────────────────────────
# Business WhatsApp number in international format without the + sign.
# Example: 6281234567890 (Indonesian number)
WHATSAPP_NUMBER=""

# ─── Image Storage (Cloudinary) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
